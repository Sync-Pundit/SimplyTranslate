{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "translate",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "previews": {},
  "migrations": [
    { "tag": "african-translator-v1", "new_sqlite_classes": ["AfricanTranslator"] }
  ],
  "assets": {
    "directory": "../static",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
